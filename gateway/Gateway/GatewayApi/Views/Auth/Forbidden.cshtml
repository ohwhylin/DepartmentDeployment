@{
    Layout = null;
    ViewData["Title"] = "Доступ запрещён";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Доступ запрещён</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --galaxy: #0B1F5C;
            --planetary: #334EAC;
            --sky: #D0E3FF;
        }

        body {
            background: #f6f8fc;
        }

        .app-navbar {
            background-color: var(--galaxy);
        }

            .app-navbar .navbar-brand {
                color: #ffffff;
            }

        .app-card {
            border: 1px solid var(--sky);
            border-radius: 12px;
            box-shadow: 0 6px 16px rgba(0,0,0,.06);
            background: #fff;
        }

        .app-card-header {
            background: var(--galaxy);
            color: #fff;
            padding: 12px 16px;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
        }

        .app-card-title {
            margin: 0;
            font-weight: 600;
        }

        .btn-app-primary {
            background: var(--galaxy);
            border-color: var(--galaxy);
            color: #fff;
        }

            .btn-app-primary:hover,
            .btn-app-primary:focus {
                background: var(--planetary);
                border-color: var(--planetary);
                color: #fff;
            }

        .btn-app-outline {
            background: transparent;
            border-color: var(--galaxy);
            color: var(--galaxy);
        }

            .btn-app-outline:hover,
            .btn-app-outline:focus {
                background: var(--galaxy);
                border-color: var(--galaxy);
                color: #fff;
            }

        .auth-shell {
            min-height: calc(100vh - 90px);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-card {
            width: 100%;
            max-width: 560px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="@(Context.Request.PathBase + "/core/")">
                Портал кафедры
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="auth-shell">
            <div class="auth-card">
                <div class="app-card">
                    <div class="app-card-header">
                        <h2 class="app-card-title">Доступ запрещён</h2>
                    </div>

                    <div class="p-4">
                        <div class="alert alert-danger mb-4">
                            У вас нет прав для доступа к этому разделу.
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button"
                                    class="btn btn-app-outline"
                                    onclick="if (window.history.length > 1) { history.back(); } else { window.location.href='@(Context.Request.PathBase + "/core/")'; }">
                                Вернуться назад
                            </button>

                            <a href="@(Context.Request.PathBase + "/core/")"
                               class="btn btn-app-primary">
                                На главную
                            </a>
                        </div>

                        <!-- @if (ViewBag.ReturnUrl != null)
                        {
                        <div class="mt-3 text-muted small">
                            Запрошенный адрес: @ViewBag.ReturnUrl
                        </div>
                        } -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>