@{
    ViewData["Title"] = "Главная";
}

<div class="app-card mb-4">
    <div class="app-card-header">
        <h2 class="app-card-title">Главная страница</h2>
    </div>
    <div class="p-3">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-3">
                @TempData["Success"]
            </div>
        }

        <p class="mb-2">
            Добро пожаловать в модуль кафедрального портала.
        </p>
        <div class="hint">
            На главной странице доступны переходы к основным разделам системы, дополнительным модулям и операциям синхронизации данных.
        </div>
    </div>
</div>

<div class="app-card mb-4">
    <div class="app-card-header">
        <h5 class="app-card-title">Дополнительные модули</h5>
    </div>
    <div class="p-3">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="app-card h-100">
                    <div class="p-3">
                        <h6 class="entity-title mb-2">Модуль расчета нагрузки</h6>
                        <div class="hint mb-3">
                            Переход к расчету и просмотру учебной нагрузки.
                        </div>
                        <a class="btn btn-app-outline" href="/polina/load/">
                            Открыть модуль
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="app-card h-100">
                    <div class="p-3">
                        <h6 class="entity-title mb-2">Модуль заведующего лабораторией</h6>
                        <div class="hint mb-3">
                            Переход к управлению данными лаборатории.
                        </div>
                        <a class="btn btn-app-outline" href="/polina/lab/">
                            Открыть модуль
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-card mb-4">
    <div class="app-card-header">
        <h5 class="app-card-title">Статистика</h5>
    </div>
    <div class="p-3">
        <div class="row g-3">

            <div class="col-md-6 col-xl-3">
                <div class="app-card h-100 border-danger-subtle">
                    <div class="p-3">
                        <div class="text-muted small">Студенты с долгами</div>
                        <div class="display-6 fw-bold">@ViewBag.DebtStudentCount</div>
                        <div class="hint">
                            @ViewBag.DebtStudentPercent% от общего числа студентов
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="app-card h-100 border-warning-subtle">
                    <div class="p-3">
                        <div class="text-muted small">Группы с долгами</div>
                        <div class="display-6 fw-bold">@ViewBag.GroupsWithDebtsCount</div>
                        <div class="hint">
                            @ViewBag.GroupsWithDebtsPercent% от общего числа групп
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="app-card h-100 border-warning-subtle">
                    <div class="p-3">
                        <div class="text-muted small">Неявки</div>
                        <div class="display-6 fw-bold">@ViewBag.AbsentCount</div>
                        <div class="hint">
                            @ViewBag.AbsentPercent% от всех записей успеваемости
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="app-card h-100 border-danger-subtle">
                    <div class="p-3">
                        <div class="text-muted small">Неудовлетворительные оценки</div>
                        <div class="display-6 fw-bold">@ViewBag.UnsatisfactoryCount</div>
                        <div class="hint">
                            @ViewBag.UnsatisfactoryPercent% от всех записей успеваемости
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="app-card h-100">
            <div class="app-card-header">
                <h5 class="app-card-title">Синхронизация данных</h5>
            </div>
            <div class="p-3 d-flex flex-column gap-2">
                <!-- <form asp-controller="Home" asp-action="QuickSync" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-app-primary w-100">
                        Быстрая синхронизация
                    </button>
                </form> -->

                <form asp-controller="AcademicPlans" asp-action="Sync" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-app-outline w-100">
                        Синхронизировать учебные планы
                    </button>
                </form>

                <form asp-controller="DisciplineStudentRecords" asp-action="Sync" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-app-outline w-100">
                        Синхронизировать успеваемость
                    </button>
                </form>

                <form asp-controller="StudentOrders" asp-action="Sync" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-app-outline w-100">
                        Синхронизировать приказы
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="app-card h-100">
            <div class="app-card-header">
                <h5 class="app-card-title">Быстрые переходы</h5>
            </div>
            <div class="p-3 d-flex flex-column gap-2">
                <a class="btn btn-app-outline w-100" asp-controller="StudentGroups" asp-action="List">
                    Открыть группы
                </a>

                <a class="btn btn-app-outline w-100" asp-controller="DisciplineStudentRecords" asp-action="List">
                    Открыть успеваемость
                </a>

                <a class="btn btn-app-outline w-100" asp-controller="StudentOrders" asp-action="List">
                    Открыть приказы
                </a>

                <!-- <a class="btn btn-app-outline w-100" asp-controller="Disciplines" asp-action="List">
                    Открыть дисциплины
                </a> -->
            </div>
        </div>
    </div>
</div>