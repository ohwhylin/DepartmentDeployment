@model DepartmentUserApp.ViewModels.StudentOrders.StudentOrderListPageViewModel
@using DepartmentDataModels.Enums

@{
    ViewData["Title"] = "Сведения о приказах";

    string GetOrderTypeName(StudentOrderType type) => type switch
    {
        StudentOrderType.Зачисление => "Зачисление",
        StudentOrderType.Распределение => "Распределение",
        StudentOrderType.Движение => "Движение",
        StudentOrderType.ПереводНаКурс => "Перевод на курс",
        StudentOrderType.ПереводВГруппу => "Перевод в группу",
        StudentOrderType.ИзАкадема => "Выход из академического отпуска",
        StudentOrderType.ВАкадем => "Академический отпуск",
        StudentOrderType.ОтчислитьЗаНеуспевамость => "Отчисление за неуспеваемость",
        StudentOrderType.ОтчислитьВСвязиСПереводом => "Отчисление в связи с переводом",
        StudentOrderType.ОтчислитьПоСобственному => "Отчисление по собственному желанию",
        StudentOrderType.ЗачислитьПоПереводу => "Зачисление переводом",
        StudentOrderType.Восстановить => "Восстановление",
        StudentOrderType.ОтчислитьПоЗавершению => "Отчисление в связи с завершением обучения",
        StudentOrderType.ПродлАкадем => "Продление академического отпуска",
        StudentOrderType.ОтчислитьЗаНевыходСАкадема => "Отчисление за невыход из академического отпуска",
        _ => type.ToString()
    };

    var startPage = Math.Max(1, Model.Result.Page - 2);
    var endPage = Math.Min(Model.Result.TotalPages, Model.Result.Page + 2);

    var orderTypeRouteValue = Model.OrderType.HasValue
        ? ((int)Model.OrderType.Value).ToString()
        : null;
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список приказов</h2>
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="StudentOrders" asp-action="Sync" method="post" class="d-inline">
                <button type="submit" class="btn btn-app-primary">Синхронизировать данные</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success m-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger m-3">
            @TempData["Error"]
        </div>
    }

    <form method="get" class="p-3 pb-0">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <input name="studentSearch"
                       value="@Model.StudentSearch"
                       type="text"
                       class="form-control"
                       placeholder="Поиск по студенту" />
            </div>

            <div class="col-md-3">
                <input name="groupSearch"
                       value="@Model.GroupSearch"
                       type="text"
                       class="form-control"
                       placeholder="Поиск по группе" />
            </div>

            <div class="col-md-3">
                <select name="orderType" class="form-select">
                    <option value="">Все типы приказов</option>
                    @foreach (var type in Model.OrderTypes.OrderBy(x => GetOrderTypeName(x)))
                    {
                        if (Model.OrderType == type)
                        {
                            <option value="@((int)type)" selected>@GetOrderTypeName(type)</option>
                        }
                        else
                        {
                            <option value="@((int)type)">@GetOrderTypeName(type)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="pageSize" class="form-select">
                    @foreach (var size in new[] { 5, 10, 20, 50 })
                    {
                        if (Model.Result.PageSize == size)
                        {
                            <option value="@size" selected>По @size</option>
                        }
                        else
                        {
                            <option value="@size">По @size</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-app-outline">Применить</button>

                <a asp-controller="StudentOrders"
                   asp-action="List"
                   class="btn btn-app-outline">
                    Сбросить
                </a>
            </div>
        </div>
    </form>

    <div class="px-3 py-2 text-muted">
        Найдено приказов: @Model.Result.TotalCount
        <span class="ms-3">Страница @Model.Result.Page из @Model.Result.TotalPages</span>
    </div>

    @if (Model.Result.Items.Count > 0)
    {
        @foreach (var orderItem in Model.Result.Items)
        {
            var order = orderItem.Order;
            var orderBlocks = orderItem.Blocks;
            var collapseId = $"orderBlocks_{order.Id}";

            <div class="plan-block order-item">
                <div class="entity-row">
                    <div class="entity-accent"></div>

                    <div class="entity-content">
                        <div class="entity-main">
                            <h5 class="entity-title">Приказ №@order.OrderNumber</h5>

                            <div class="entity-meta d-flex flex-column gap-1">
                                <div><strong>Тип приказа:</strong> @GetOrderTypeName(order.StudentOrderType)</div>
                                <div><strong>Дата приказа:</strong> @order.OrderDate.ToString("dd.MM.yyyy")</div>
                                <div><strong>Количество блоков:</strong> @orderBlocks.Count</div>
                            </div>
                        </div>
                    </div>

                    <div class="entity-actions">
                        <div class="actions-stack">
                            <a class="btn btn-sm btn-app-outline"
                               asp-controller="StudentOrders"
                               asp-action="Details"
                               asp-route-id="@order.Id">
                                Подробнее
                            </a>

                            <button class="btn btn-sm btn-app-outline"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                Показать блоки
                            </button>
                        </div>
                    </div>
                </div>

                <div class="collapse" id="@collapseId">
                    <div class="plan-records-wrap">
                        @if (orderBlocks.Count > 0)
                        {
                            @foreach (var blockItem in orderBlocks)
                            {
                                var block = blockItem.Block;
                                var currentBlockStudents = blockItem.Students;

                                <div class="order-block-card">
                                    <div class="order-block-head">
                                        <div class="order-block-info">
                                            <div class="plan-record-title">Блок приказа</div>

                                            <div class="entity-meta d-flex flex-column gap-1">
                                                <div><strong>Тип блока:</strong> @GetOrderTypeName(block.StudentOrderType)</div>
                                                <div><strong>Направление:</strong> @(string.IsNullOrWhiteSpace(block.EducationDirection) ? "—" : block.EducationDirection)</div>
                                                <div><strong>Количество студентов:</strong> @currentBlockStudents.Count</div>
                                            </div>
                                        </div>

                                        <div class="plan-record-actions">
                                            <a class="btn btn-sm btn-app-outline"
                                               asp-controller="StudentOrderBlocks"
                                               asp-action="Details"
                                               asp-route-id="@block.Id">
                                                Подробнее
                                            </a>
                                        </div>
                                    </div>

                                    <div class="table-responsive mt-3">
                                        <table class="table table-app align-middle order-students-table">
                                            <thead>
                                                <tr>
                                                    <th>Студент</th>
                                                    <th>Из группы</th>
                                                    <th>В группу</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (currentBlockStudents.Count > 0)
                                                {
                                                    @foreach (var blockStudent in currentBlockStudents)
                                                    {
                                                        <tr>
                                                            <td>@(string.IsNullOrWhiteSpace(blockStudent.Student) ? "—" : blockStudent.Student)</td>
                                                            <td>@(string.IsNullOrWhiteSpace(blockStudent.StudentGroupFrom) ? "—" : blockStudent.StudentGroupFrom)</td>
                                                            <td>@(string.IsNullOrWhiteSpace(blockStudent.StudentGroupTo) ? "—" : blockStudent.StudentGroupTo)</td>
                                                            <td class="text-end">
                                                                <a class="btn btn-sm btn-app-outline"
                                                                   asp-controller="StudentOrderBlockStudents"
                                                                   asp-action="Details"
                                                                   asp-route-id="@blockStudent.Id">
                                                                    Подробнее
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-muted">
                                                            Для данного блока студенты отсутствуют.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">
                                Для данного приказа блоки отсутствуют.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <div class="p-3 pt-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="pager-summary">
                    Показана страница @Model.Result.Page из @Model.Result.TotalPages
                </div>

                <nav aria-label="Пагинация">
                    <ul class="pagination app-pagination mb-0">
                        <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-studentSearch="@Model.StudentSearch"
                               asp-route-groupSearch="@Model.GroupSearch"
                               asp-route-orderType="@orderTypeRouteValue"
                               asp-route-page="1"
                               asp-route-pageSize="@Model.Result.PageSize">
                                В начало
                            </a>
                        </li>

                        <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-studentSearch="@Model.StudentSearch"
                               asp-route-groupSearch="@Model.GroupSearch"
                               asp-route-orderType="@orderTypeRouteValue"
                               asp-route-page="@(Model.Result.Page - 1)"
                               asp-route-pageSize="@Model.Result.PageSize">
                                Назад
                            </a>
                        </li>

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == Model.Result.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-orderType="@orderTypeRouteValue"
                                   asp-route-page="@p"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-studentSearch="@Model.StudentSearch"
                               asp-route-groupSearch="@Model.GroupSearch"
                               asp-route-orderType="@orderTypeRouteValue"
                               asp-route-page="@(Model.Result.Page + 1)"
                               asp-route-pageSize="@Model.Result.PageSize">
                                Вперёд
                            </a>
                        </li>

                        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-studentSearch="@Model.StudentSearch"
                               asp-route-groupSearch="@Model.GroupSearch"
                               asp-route-orderType="@orderTypeRouteValue"
                               asp-route-page="@Model.Result.TotalPages"
                               asp-route-pageSize="@Model.Result.PageSize">
                                В конец
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary m-3">
            По заданным параметрам приказы не найдены.
        </div>
    }
</div>

@section Styles {
    <style>
        .plan-block {
            border-top: 1px solid var(--sky);
        }

            .plan-block:first-of-type {
                border-top: none;
            }

            .plan-block .entity-row {
                border-top: none;
            }

        .plan-records-wrap {
            margin-left: 8px;
            border-top: 1px solid var(--sky);
            background: #f8fbff;
            padding: 12px 14px 12px 22px;
        }

        .order-block-card {
            padding: 14px 0;
            border-bottom: 1px solid #e3eefb;
        }

            .order-block-card:last-child {
                border-bottom: none;
            }

        .order-block-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
        }

        .order-block-info {
            flex: 1;
            min-width: 0;
        }

        .plan-record-title {
            margin: 0 0 6px 0;
            font-weight: 700;
            color: var(--galaxy);
            line-height: 1.2;
        }

        .plan-record-actions {
            flex-shrink: 0;
            padding-top: 2px;
        }

        .order-students-table {
            margin-bottom: 0;
        }

            .order-students-table thead th {
                white-space: nowrap;
                vertical-align: middle;
            }

            .order-students-table td {
                vertical-align: middle;
            }

        .app-pagination .page-link {
            color: var(--galaxy);
            border-color: var(--sky);
            background: #fff;
        }

            .app-pagination .page-link:hover,
            .app-pagination .page-link:focus {
                color: var(--galaxy);
                background: var(--sky);
                border-color: var(--sky);
                box-shadow: none;
            }

        .app-pagination .page-item.active .page-link {
            background: var(--galaxy);
            border-color: var(--galaxy);
            color: #fff;
        }

        .app-pagination .page-item.disabled .page-link {
            color: #8d99ae;
            background: #fff;
            border-color: var(--sky);
        }

        .pager-summary {
            color: #6c757d;
            font-size: .95rem;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collapseElements = document.querySelectorAll('.collapse');

            collapseElements.forEach(function (collapseElement) {
                collapseElement.addEventListener('shown.bs.collapse', function () {
                    const button = document.querySelector('[data-bs-target="#' + collapseElement.id + '"]');
                    if (button) {
                        button.textContent = 'Скрыть блоки';
                    }
                });

                collapseElement.addEventListener('hidden.bs.collapse', function () {
                    const button = document.querySelector('[data-bs-target="#' + collapseElement.id + '"]');
                    if (button) {
                        button.textContent = 'Показать блоки';
                    }
                });
            });
        });
    </script>
}