@model DepartmentUserApp.ViewModels.StudentGroups.StudentGroupListPageViewModel
@using DepartmentDataModels.Enums

@{
    ViewData["Title"] = "StudentGroups";

    int GetMaxSemesterForCourse(AcademicCourse course) => course switch
    {
        AcademicCourse.Course_1 => 2,
        AcademicCourse.Course_2 => 4,
        AcademicCourse.Course_3 => 6,
        AcademicCourse.Course_4 => 8,
        _ => 0
    };

    string GetSemesterName(Semesters semester) => semester switch
    {
        Semesters.Первый => "1 семестр",
        Semesters.Второй => "2 семестр",
        Semesters.Третий => "3 семестр",
        Semesters.Четвертый => "4 семестр",
        Semesters.Пятый => "5 семестр",
        Semesters.Шестой => "6 семестр",
        Semesters.Седьмой => "7 семестр",
        Semesters.Восьмой => "8 семестр",
        _ => semester.ToString()
    };

    int GetDebtAgeInSemesters(AcademicCourse course, Semesters debtSemester)
    {
        var currentMaxSemester = GetMaxSemesterForCourse(course);
        var age = currentMaxSemester - (int)debtSemester;
        return age < 0 ? 0 : age;
    }

    bool IsHighRiskDebt(AcademicCourse course, Semesters debtSemester)
    {
        return GetDebtAgeInSemesters(course, debtSemester) > 2;
    }

    string GetCourseName(AcademicCourse course) => course switch
    {
        AcademicCourse.Course_1 => "Первый курс",
        AcademicCourse.Course_2 => "Второй курс",
        AcademicCourse.Course_3 => "Третий курс",
        AcademicCourse.Course_4 => "Четвёртый курс",
        _ => course.ToString()
    };

    string GetStudentStateName(StudentState state) => state switch
    {
        StudentState.Учится => "Обучается",
        StudentState.Академ => "Академический отпуск",
        StudentState.Отчислен => "Отчислен",
        StudentState.Завершил => "Выпустился",
        _ => state.ToString()
    };

    var courseValues = Enum.GetValues<AcademicCourse>();
    var courseRouteValue = Model.Course.HasValue
        ? ((int)Model.Course.Value).ToString()
        : null;

    var startPage = Math.Max(1, Model.Result.Page - 2);
    var endPage = Math.Min(Model.Result.TotalPages, Model.Result.Page + 2);

    var expandStudents = !string.IsNullOrWhiteSpace(Model.StudentSearch) || Model.OnlyStudentsWithDebts;
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список учебных групп</h2>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-app-outline"
               asp-controller="Home"
               asp-action="Index">
                Назад
            </a>

            <form asp-controller="StudentGroups" asp-action="Sync" method="post" class="d-inline">
                <button type="submit" class="btn btn-app-primary">Синхронизировать данные</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success m-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger m-3">
            @TempData["Error"]
        </div>
    }

    <form method="get" class="p-3 border-bottom">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input name="groupSearch"
                       value="@Model.GroupSearch"
                       type="text"
                       class="form-control"
                       placeholder="Поиск по группе" />
            </div>

            <div class="col-md-4">
                <input name="studentSearch"
                       value="@Model.StudentSearch"
                       type="text"
                       class="form-control"
                       placeholder="Поиск по студенту" />
            </div>

            <div class="col-md-3">
                <select name="course" class="form-select">
                    <option value="">Все курсы</option>
                    @foreach (var courseValue in courseValues)
                    {
                        if (Model.Course == courseValue)
                        {
                            <option value="@((int)courseValue)" selected>@GetCourseName(courseValue)</option>
                        }
                        else
                        {
                            <option value="@((int)courseValue)">@GetCourseName(courseValue)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-auto">
                <button type="submit" class="btn btn-app-outline">Применить</button>
            </div>

            <div class="col-md-auto">
                <a asp-controller="StudentGroups"
                   asp-action="List"
                   class="btn btn-app-outline">
                    Сбросить
                </a>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-auto">
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="onlyGroupsWithDebts"
                           value="true"
                           id="onlyGroupsWithDebts"
                           @(Model.OnlyGroupsWithDebts ? "checked" : "") />
                    <label class="form-check-label" for="onlyGroupsWithDebts">
                        Только группы с долгами
                    </label>
                </div>
            </div>

            <div class="col-md-auto">
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="onlyStudentsWithDebts"
                           value="true"
                           id="onlyStudentsWithDebts"
                           @(Model.OnlyStudentsWithDebts ? "checked" : "") />
                    <label class="form-check-label" for="onlyStudentsWithDebts">
                        Показывать только студентов с долгами
                    </label>
                </div>
            </div>

            <div class="col-md-auto">
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="onlyHighRisk"
                           value="true"
                           id="onlyHighRisk"
                           @(Model.OnlyHighRisk ? "checked" : "") />
                    <label class="form-check-label" for="onlyHighRisk">
                        Только высокий риск отчисления
                    </label>
                </div>
            </div>
        </div>

        <input type="hidden" name="pageSize" value="@Model.Result.PageSize" />
    </form>

    <div class="px-3 pb-2 pt-3 text-muted">
        Найдено групп: @Model.Result.TotalCount
    </div>

    @if (Model.Result.Items.Count > 0)
    {
        @foreach (var item in Model.Result.Items)
        {
            var group = item.Group;
            var students = item.Students;
            var collapseId = $"groupStudents_{group.Id}";
            var buttonId = $"toggleBtn_{group.Id}";

            <div class="group-block">
                <div class="entity-row">
                    <div class="entity-accent"></div>

                    <div class="entity-content">
                        <div class="entity-main">
                            <h5 class="entity-title">@group.GroupName</h5>

                            <div class="entity-meta d-flex flex-column gap-1">
                                <div><strong>Направление:</strong> @group.EducationDirection</div>
                                <div><strong>Курс:</strong> @GetCourseName(group.Course)</div>
                                <div><strong>Количество студентов:</strong> @item.StudentCount</div>

                                @if (!string.IsNullOrWhiteSpace(group.Curator))
                                {
                                    <div><strong>Куратор:</strong> @group.Curator</div>
                                }

                                @if (Model.OnlyStudentsWithDebts || !string.IsNullOrWhiteSpace(Model.StudentSearch))
                                {
                                    <div><strong>Показано студентов:</strong> @students.Count</div>
                                }

                                @if (item.StudentsWithDebtsCount > 0)
                                {
                                    <div class="mt-2">
                                        <div class="alert @(item.HighRiskStudentsCount > 0 ? "alert-danger" : "alert-warning") py-2 mb-0">
                                            <strong>Внимание:</strong>
                                            в группе есть студенты с академическими задолженностями —
                                            @item.StudentsWithDebtsCount чел.
                                            @if (item.HighRiskStudentsCount > 0)
                                            {
                                                <span>
                                                    Из них у @item.HighRiskStudentsCount чел. долги старше двух семестров.
                                                    Возможен риск отчисления.
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="entity-actions">
                        <div class="actions-stack">
                            <a class="btn btn-sm btn-app-outline"
                               asp-controller="StudentGroups"
                               asp-action="Details"
                               asp-route-id="@group.Id">
                                Подробнее
                            </a>

                            <button id="@buttonId"
                                    class="btn btn-sm btn-app-outline"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(expandStudents ? "true" : "false")"
                                    aria-controls="@collapseId">
                                @(expandStudents ? "Скрыть студентов" : "Показать студентов")
                            </button>
                        </div>
                    </div>
                </div>

                <div class="collapse @(expandStudents ? "show" : "")" id="@collapseId">
                    <div class="group-students-wrap">
                        @if (students.Count > 0)
                        {
                            @foreach (var studentItem in students)
                            {
                                var student = studentItem.Student;
                                var studentDebtRecords = studentItem.Debts;
                                var hasHighRiskDebt = studentItem.HasHighRiskDebt;

                                <div class="group-student-item">
                                    <div class="group-student-info">
                                        <div class="group-student-title">
                                            @student.LastName @student.FirstName @student.Patronymic
                                        </div>

                                        <div class="entity-meta d-flex flex-column gap-1">
                                            <div><strong>Номер зачётной книжки:</strong> @student.NumberOfBook</div>
                                            <div><strong>Статус:</strong> @GetStudentStateName(student.StudentState)</div>

                                            @if (!string.IsNullOrWhiteSpace(student.Email))
                                            {
                                                <div><strong>Электронная почта:</strong> @student.Email</div>
                                            }

                                            @if (student.IsSteward)
                                            {
                                                <div><strong>Роль:</strong> Староста группы</div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(student.Description))
                                            {
                                                <div><strong>Примечание:</strong> @student.Description</div>
                                            }

                                            @if (studentDebtRecords.Any())
                                            {
                                                <div class="mt-2">
                                                    <div class="alert @(hasHighRiskDebt ? "alert-danger" : "alert-warning") py-2 mb-0">
                                                        <div>
                                                            <strong>Академические задолженности:</strong>
                                                        </div>

                                                        <ul class="mb-0 mt-1 ps-3">
                                                            @foreach (var debt in studentDebtRecords)
                                                            {
                                                                var ageInSemesters = GetDebtAgeInSemesters(group.Course, debt.Semester);

                                                                <li>
                                                                    @(string.IsNullOrWhiteSpace(debt.Discipline) ? "Неизвестная дисциплина" : debt.Discipline)
                                                                    — @GetSemesterName(debt.Semester)

                                                                    @if (IsHighRiskDebt(group.Course, debt.Semester))
                                                                    {
                                                                        <span class="text-danger">
                                                                            (долг старше двух семестров, возможен риск отчисления)
                                                                        </span>
                                                                    }
                                                                    else if (ageInSemesters > 0)
                                                                    {
                                                                        <span class="text-muted">
                                                                            (долг сохраняется @ageInSemesters сем.)
                                                                        </span>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="group-student-actions">
                                        <a class="btn btn-sm btn-app-outline"
                                           asp-controller="Students"
                                           asp-action="Details"
                                           asp-route-id="@student.Id">
                                            Подробнее
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">
                                По выбранным фильтрам студенты не найдены.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <div class="app-pagination-wrap">
                <div class="app-pagination-meta">
                    Страница @Model.Result.Page из @Model.Result.TotalPages
                    <span class="mx-2">•</span>
                    Всего групп: @Model.Result.TotalCount
                </div>

                <nav class="app-pagination" aria-label="Пагинация">
                    <ul class="pagination mb-0">

                        @if (Model.Result.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-course="@courseRouteValue"
                                   asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                   asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                   asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    В начало
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В начало</span>
                            </li>
                        }

                        @if (Model.Result.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-course="@courseRouteValue"
                                   asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                   asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                   asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                   asp-route-page="@(Model.Result.Page - 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Назад
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Назад</span>
                            </li>
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-course="@courseRouteValue"
                                   asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                   asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                   asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    1
                                </a>
                            </li>

                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            if (p == Model.Result.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@p</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="List"
                                       asp-route-groupSearch="@Model.GroupSearch"
                                       asp-route-studentSearch="@Model.StudentSearch"
                                       asp-route-course="@courseRouteValue"
                                       asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                       asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                       asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                       asp-route-page="@p"
                                       asp-route-pageSize="@Model.Result.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                        }

                        @if (endPage < Model.Result.TotalPages)
                        {
                            @if (endPage < Model.Result.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-course="@courseRouteValue"
                                   asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                   asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                   asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                   asp-route-page="@Model.Result.TotalPages"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    @Model.Result.TotalPages
                                </a>
                            </li>
                        }

                        @if (Model.Result.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-course="@courseRouteValue"
                                   asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                   asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                   asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                   asp-route-page="@(Model.Result.Page + 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Вперёд
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Вперёд</span>
                            </li>
                        }

                        @if (Model.Result.Page < Model.Result.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-course="@courseRouteValue"
                                   asp-route-onlyGroupsWithDebts="@Model.OnlyGroupsWithDebts"
                                   asp-route-onlyStudentsWithDebts="@Model.OnlyStudentsWithDebts"
                                   asp-route-onlyHighRisk="@Model.OnlyHighRisk"
                                   asp-route-page="@Model.Result.TotalPages"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    В конец
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В конец</span>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary m-3">
            По выбранным параметрам группы не найдены.
        </div>
    }
</div>

@section Styles {
    <style>
        .group-block {
            border-top: 1px solid var(--sky);
        }

            .group-block:first-of-type {
                border-top: none;
            }

            .group-block .entity-row {
                border-top: none;
            }

        .group-students-wrap {
            margin-left: 8px;
            border-top: 1px solid var(--sky);
            background: #f8fbff;
            padding: 12px 14px 12px 22px;
        }

        .group-student-item {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            padding: 12px 0;
            border-bottom: 1px solid #e3eefb;
        }

            .group-student-item:last-child {
                border-bottom: none;
            }

        .group-student-info {
            flex: 1;
            min-width: 0;
        }

        .group-student-title {
            margin: 0 0 6px 0;
            font-weight: 700;
            color: var(--galaxy);
            line-height: 1.2;
        }

        .group-student-actions {
            flex-shrink: 0;
            padding-top: 2px;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collapseElements = document.querySelectorAll('.collapse');

            collapseElements.forEach(function (collapseElement) {
                collapseElement.addEventListener('shown.bs.collapse', function () {
                    const button = document.querySelector('[data-bs-target="#' + collapseElement.id + '"]');
                    if (button && collapseElement.id.startsWith('groupStudents_')) {
                        button.textContent = 'Скрыть студентов';
                    }
                });

                collapseElement.addEventListener('hidden.bs.collapse', function () {
                    const button = document.querySelector('[data-bs-target="#' + collapseElement.id + '"]');
                    if (button && collapseElement.id.startsWith('groupStudents_')) {
                        button.textContent = 'Показать студентов';
                    }
                });
            });
        });
    </script>
}