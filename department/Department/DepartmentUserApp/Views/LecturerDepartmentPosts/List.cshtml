@model DepartmentUserApp.ViewModels.LecturerDepartmentPosts.LecturerDepartmentPostListPageViewModel

@{
    ViewData["Title"] = "LecturerDepartmentPosts";

    var startPage = Math.Max(1, Model.Result.Page - 2);
    var endPage = Math.Min(Model.Result.TotalPages, Model.Result.Page + 2);
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список кафедральных должностей</h2>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-app-outline"
               asp-controller="Home"
               asp-action="Index">
                Назад
            </a>

            <a class="btn btn-app-primary"
               asp-controller="LecturerDepartmentPosts"
               asp-action="Create">
                Добавить
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="p-3 pb-0">
            <div class="alert alert-danger mb-0">@TempData["Error"]</div>
        </div>
    }

    <form method="get" class="p-3 d-flex gap-2 flex-wrap">
        <input type="text"
               name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Поиск по наименованию должности"
               style="max-width: 360px;" />

        <input type="hidden" name="pageSize" value="@Model.Result.PageSize" />

        <button type="submit" class="btn btn-app-outline">Применить</button>

        <a class="btn btn-app-outline"
           asp-controller="LecturerDepartmentPosts"
           asp-action="List">
            Сбросить
        </a>
    </form>

    <div class="px-3 pb-2 text-muted">
        Найдено кафедральных должностей: @Model.Result.TotalCount
    </div>

    @if (Model.Result.Items.Count > 0)
    {
        @foreach (var item in Model.Result.Items)
        {
            <div class="entity-row">
                <div class="entity-accent"></div>

                <div class="entity-content">
                    <div class="entity-main">
                        <h5 class="entity-title">@item.DepartmentPostTitle</h5>

                        <div class="entity-meta d-flex flex-column gap-1">
                            <div><strong>Наименование должности:</strong> @item.DepartmentPostTitle</div>
                        </div>
                    </div>
                </div>

                <div class="entity-actions">
                    <div class="actions-stack">
                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="LecturerDepartmentPosts"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Подробнее
                        </a>

                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="LecturerDepartmentPosts"
                           asp-action="Update"
                           asp-route-id="@item.Id">
                            Изменить
                        </a>

                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="LecturerDepartmentPosts"
                           asp-action="Delete"
                           asp-route-id="@item.Id">
                            Удалить
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <div class="app-pagination-wrap">
                <div class="app-pagination-meta">
                    Страница @Model.Result.Page из @Model.Result.TotalPages
                    <span class="mx-2">•</span>
                    Всего должностей: @Model.Result.TotalCount
                </div>

                <nav class="app-pagination" aria-label="Пагинация">
                    <ul class="pagination mb-0">

                        @if (Model.Result.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    В начало
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В начало</span>
                            </li>
                        }

                        @if (Model.Result.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Result.Page - 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Назад
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Назад</span>
                            </li>
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    1
                                </a>
                            </li>

                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            if (p == Model.Result.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@p</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="List"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@p"
                                       asp-route-pageSize="@Model.Result.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                        }

                        @if (endPage < Model.Result.TotalPages)
                        {
                            @if (endPage < Model.Result.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@Model.Result.TotalPages"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    @Model.Result.TotalPages
                                </a>
                            </li>
                        }

                        @if (Model.Result.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Result.Page + 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Вперёд
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Вперёд</span>
                            </li>
                        }

                        @if (Model.Result.Page < Model.Result.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@Model.Result.TotalPages"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    В конец
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В конец</span>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary m-3">
            По выбранным параметрам кафедральные должности не найдены.
        </div>
    }
</div>