@model DepartmentUserApp.ViewModels.Classrooms.ClassroomListPageViewModel
@using DepartmentDataModels.Enums

@{
    ViewData["Title"] = "Classrooms";

    var classroomTypes = Enum.GetValues<ClassroomTypes>();

    var typeRouteValue = Model.Type.HasValue
        ? ((int)Model.Type.Value).ToString()
        : null;

    var projectorRouteValue = Model.HasProjector.HasValue
        ? Model.HasProjector.Value.ToString().ToLowerInvariant()
        : null;

    var scheduleRouteValue = Model.UseInSchedule.HasValue
        ? Model.UseInSchedule.Value.ToString().ToLowerInvariant()
        : null;

    var startPage = Math.Max(1, Model.Result.Page - 2);
    var endPage = Math.Min(Model.Result.TotalPages, Model.Result.Page + 2);
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список аудиторий</h2>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-app-outline"
               asp-controller="Home"
               asp-action="Index">
                Назад
            </a>

            <a class="btn btn-app-primary"
               asp-controller="Classrooms"
               asp-action="Create">
                Добавить
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="p-3 pb-0">
            <div class="alert alert-danger mb-0">@TempData["Error"]</div>
        </div>
    }

    <form method="get" class="p-3 d-flex gap-2 flex-wrap">
        <input type="text"
               name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Поиск по номеру аудитории"
               style="max-width: 260px;" />

        <select name="type" class="form-select" style="max-width: 240px;">
            <option value="">Все типы аудиторий</option>
            @foreach (var type in classroomTypes)
            {
                if (Model.Type == type)
                {
                    <option value="@((int)type)" selected>@type</option>
                }
                else
                {
                    <option value="@((int)type)">@type</option>
                }
            }
        </select>

        <select name="hasProjector" class="form-select" style="max-width: 220px;">
            <option value="">Проектор: все</option>
            @if (Model.HasProjector == true)
            {
                <option value="true" selected>Только с проектором</option>
            }
            else
            {
                <option value="true">Только с проектором</option>
            }

            @if (Model.HasProjector == false)
            {
                <option value="false" selected>Только без проектора</option>
            }
            else
            {
                <option value="false">Только без проектора</option>
            }
        </select>

        <select name="useInSchedule" class="form-select" style="max-width: 260px;">
            <option value="">Расписание: все</option>
            @if (Model.UseInSchedule == true)
            {
                <option value="true" selected>Только участвующие в расписании</option>
            }
            else
            {
                <option value="true">Только участвующие в расписании</option>
            }

            @if (Model.UseInSchedule == false)
            {
                <option value="false" selected>Только не участвующие в расписании</option>
            }
            else
            {
                <option value="false">Только не участвующие в расписании</option>
            }
        </select>

        <input type="hidden" name="pageSize" value="@Model.Result.PageSize" />

        <button type="submit" class="btn btn-app-outline">Применить</button>

        <a class="btn btn-app-outline"
           asp-controller="Classrooms"
           asp-action="List">
            Сбросить
        </a>
    </form>

    <div class="px-3 pb-2 text-muted">
        Найдено аудиторий: @Model.Result.TotalCount
    </div>

    @if (Model.Result.Items.Count > 0)
    {
        @foreach (var item in Model.Result.Items)
        {
            <div class="entity-row">
                <div class="entity-accent"></div>

                <div class="entity-content">
                    <div class="entity-main">
                        <h5 class="entity-title">Аудитория @item.Number</h5>

                        <div class="entity-meta d-flex flex-column gap-1">
                            <div><strong>Номер аудитории:</strong> @item.Number</div>
                            <div><strong>Тип аудитории:</strong> @item.Type</div>
                            <div><strong>Вместимость:</strong> @item.Capacity</div>
                            <div><strong>Проектор:</strong> @(item.HasProjector ? "Имеется проектор" : "Нет проектора")</div>
                            <div><strong>Использование в расписании:</strong> @(item.NotUseInSchedule ? "Не участвует в расписании" : "Участвует в расписании")</div>
                        </div>
                    </div>
                </div>

                <div class="entity-actions">
                    <div class="actions-stack">
                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="Classrooms"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Подробнее
                        </a>

                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="Classrooms"
                           asp-action="Update"
                           asp-route-id="@item.Id">
                            Изменить
                        </a>

                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="Classrooms"
                           asp-action="Delete"
                           asp-route-id="@item.Id">
                            Удалить
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <div class="app-pagination-wrap">
                <div class="app-pagination-meta">
                    Страница @Model.Result.Page из @Model.Result.TotalPages
                    <span class="mx-2">•</span>
                    Всего аудиторий: @Model.Result.TotalCount
                </div>

                <nav class="app-pagination" aria-label="Пагинация">
                    <ul class="pagination mb-0">

                        @if (Model.Result.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-type="@typeRouteValue"
                                   asp-route-hasProjector="@projectorRouteValue"
                                   asp-route-useInSchedule="@scheduleRouteValue"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    В начало
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В начало</span>
                            </li>
                        }

                        @if (Model.Result.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-type="@typeRouteValue"
                                   asp-route-hasProjector="@projectorRouteValue"
                                   asp-route-useInSchedule="@scheduleRouteValue"
                                   asp-route-page="@(Model.Result.Page - 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Назад
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Назад</span>
                            </li>
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-type="@typeRouteValue"
                                   asp-route-hasProjector="@projectorRouteValue"
                                   asp-route-useInSchedule="@scheduleRouteValue"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    1
                                </a>
                            </li>

                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            if (p == Model.Result.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@p</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="List"
                                       asp-route-search="@Model.Search"
                                       asp-route-type="@typeRouteValue"
                                       asp-route-hasProjector="@projectorRouteValue"
                                       asp-route-useInSchedule="@scheduleRouteValue"
                                       asp-route-page="@p"
                                       asp-route-pageSize="@Model.Result.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                        }

                        @if (endPage < Model.Result.TotalPages)
                        {
                            @if (endPage < Model.Result.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-type="@typeRouteValue"
                                   asp-route-hasProjector="@projectorRouteValue"
                                   asp-route-useInSchedule="@scheduleRouteValue"
                                   asp-route-page="@Model.Result.TotalPages"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    @Model.Result.TotalPages
                                </a>
                            </li>
                        }

                        @if (Model.Result.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-type="@typeRouteValue"
                                   asp-route-hasProjector="@projectorRouteValue"
                                   asp-route-useInSchedule="@scheduleRouteValue"
                                   asp-route-page="@(Model.Result.Page + 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Вперёд
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Вперёд</span>
                            </li>
                        }

                        @if (Model.Result.Page < Model.Result.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-type="@typeRouteValue"
                                   asp-route-hasProjector="@projectorRouteValue"
                                   asp-route-useInSchedule="@scheduleRouteValue"
                                   asp-route-page="@Model.Result.TotalPages"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    В конец
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В конец</span>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary m-3">
            По выбранным параметрам аудитории не найдены.
        </div>
    }
</div>