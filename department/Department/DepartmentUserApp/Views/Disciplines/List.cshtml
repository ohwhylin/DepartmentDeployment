@model DepartmentUserApp.ViewModels.Disciplines.DisciplineListPageViewModel

@{
    ViewData["Title"] = "Disciplines";

    var startPage = Math.Max(1, Model.Result.Page - 2);
    var endPage = Math.Min(Model.Result.TotalPages, Model.Result.Page + 2);
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список дисциплин</h2>
        </div>
    </div>

    <form method="get" class="p-3 d-flex gap-2 flex-wrap">
        <input type="text"
               name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Поиск по названию, краткому имени, описанию"
               style="max-width: 350px;" />

        <input type="hidden" name="pageSize" value="@Model.Result.PageSize" />

        <button type="submit" class="btn btn-app-outline">Применить</button>

        <a class="btn btn-app-outline"
           asp-controller="Disciplines"
           asp-action="List">
            Сбросить
        </a>
    </form>

    @if (TempData["Error"] != null)
    {
        <div class="p-3 pt-0">
            <div class="alert alert-danger mb-0">@TempData["Error"]</div>
        </div>
    }

    <div class="px-3 pb-2 text-muted">
        Найдено дисциплин: @Model.Result.TotalCount
    </div>

    @if (Model.Result.Items.Count > 0)
    {
        @foreach (var item in Model.Result.Items)
        {
            <div class="entity-row">
                <div class="entity-accent"></div>

                <div class="entity-content">
                    <div class="entity-main">
                        <h5 class="entity-title">
                            @(string.IsNullOrWhiteSpace(item.DisciplineName) ? "—" : item.DisciplineName)
                        </h5>

                        <div class="entity-meta d-flex flex-column gap-1">
                            <div><strong>Полное наименование:</strong> @(string.IsNullOrWhiteSpace(item.DisciplineName) ? "—" : item.DisciplineName)</div>
                            <div><strong>Краткое наименование:</strong> @(string.IsNullOrWhiteSpace(item.DisciplineShortName) ? "—" : item.DisciplineShortName)</div>
                            <div><strong>Описание:</strong> @(string.IsNullOrWhiteSpace(item.DisciplineDescription) ? "—" : item.DisciplineDescription)</div>
                        </div>
                    </div>
                </div>

                <div class="entity-actions">
                    <div class="actions-stack">
                        <a class="btn btn-sm btn-app-outline"
                           asp-controller="Disciplines"
                           asp-action="Details"
                           asp-route-id="@item.Id">
                            Подробнее
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <div class="app-pagination-wrap">
                <nav class="app-pagination" aria-label="Пагинация">
                    <ul class="pagination mb-0">

                        @if (Model.Result.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Result.Page - 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Назад
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Назад</span>
                            </li>
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            if (p == Model.Result.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@p</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="List"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@p"
                                       asp-route-pageSize="@Model.Result.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                        }

                        @if (Model.Result.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Result.Page + 1)"
                                   asp-route-pageSize="@Model.Result.PageSize">
                                    Вперёд
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Вперёд</span>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="p-3">
            <div class="alert alert-secondary mb-0">
                По заданным параметрам дисциплины не найдены.
            </div>
        </div>
    }
</div>