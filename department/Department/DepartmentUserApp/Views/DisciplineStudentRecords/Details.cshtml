@model DepartmentContracts.ViewModels.DisciplineStudentRecordViewModel
@using DepartmentDataModels.Enums

@{
    ViewData["Title"] = "Подробнее об отметке";

    string GetSemesterName(Semesters semester) => semester switch
    {
        Semesters.Первый => "1 семестр",
        Semesters.Второй => "2 семестр",
        Semesters.Третий => "3 семестр",
        Semesters.Четвертый => "4 семестр",
        Semesters.Пятый => "5 семестр",
        Semesters.Шестой => "6 семестр",
        Semesters.Седьмой => "7 семестр",
        Semesters.Восьмой => "8 семестр",
        _ => semester.ToString()
    };

    string GetMarkName(MarkType mark) => mark switch
    {
        MarkType.Отлично => "Отлично",
        MarkType.Хорошо => "Хорошо",
        MarkType.Удовлетворительно => "Удовлетворительно",
        MarkType.Неудовлетворительно => "Неудовлетворительно",
        MarkType.Неявка => "Неявка",
        _ => mark.ToString()
    };

    string FormatMarkDate(DateTime? markDate)
    {
        return markDate.HasValue
            ? markDate.Value.ToString("dd.MM.yyyy")
            : "—";
    }
}

<div class="app-card">
    <div class="app-card-header">
        <h2 class="app-card-title">Подробнее об отметке</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-light" asp-controller="DisciplineStudentRecords" asp-action="List">К списку</a>
        </div>
    </div>

    <div class="p-3">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Дисциплина</dt>
            <dd class="col-sm-8">@Model.Discipline</dd>

            <dt class="col-sm-4 text-muted">Студент</dt>
            <dd class="col-sm-8">@Model.Student</dd>

            <dt class="col-sm-4 text-muted">Семестр</dt>
            <dd class="col-sm-8">@GetSemesterName(Model.Semester)</dd>

            <dt class="col-sm-4 text-muted">Вариант аттестации</dt>
            <dd class="col-sm-8">@Model.Variant</dd>

            <dt class="col-sm-4 text-muted">Подгруппа</dt>
            <dd class="col-sm-8">@Model.SubGroup</dd>

            <dt class="col-sm-4 text-muted">Оценка</dt>
            <dd class="col-sm-8">@GetMarkName(Model.MarkType)</dd>

            <dt class="col-sm-4 text-muted">Дата выставления</dt>
            <dd class="col-sm-8">@FormatMarkDate(Model.MarkDate)</dd>
        </dl>
    </div>
</div>