@model DepartmentContracts.ViewModels.DisciplineStudentRecordGroupPageViewModel
@using System.Linq
@using DepartmentContracts.ViewModels
@using DepartmentDataModels.Enums

@{
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    ViewData["Title"] = "Сведения об успеваемости";

    var records = Model.Records ?? new List<DisciplineStudentRecordViewModel>();
    var disciplines = Model.Disciplines ?? new List<DisciplineViewModel>();
    var students = Model.Students ?? new List<StudentViewModel>();
    var groups = Model.Groups?.Items ?? new List<StudentGroupViewModel>();

    string GetCourseName(AcademicCourse course) => course switch
    {
        AcademicCourse.Course_1 => "Первый курс",
        AcademicCourse.Course_2 => "Второй курс",
        AcademicCourse.Course_3 => "Третий курс",
        AcademicCourse.Course_4 => "Четвёртый курс",
        _ => course.ToString()
    };

    string GetStudentStateName(StudentState state) => state switch
    {
        StudentState.Учится => "Обучается",
        StudentState.Академ => "Академический отпуск",
        StudentState.Отчислен => "Отчислен",
        StudentState.Завершил => "Выпустился",
        _ => state.ToString()
    };

    string GetMarkName(MarkType mark) => mark switch
    {
        MarkType.Отлично => "Отлично",
        MarkType.Хорошо => "Хорошо",
        MarkType.Удовлетворительно => "Удовлетворительно",
        MarkType.Неудовлетворительно => "Неудовлетворительно",
        MarkType.Неявка => "Неявка",
        _ => mark.ToString()
    };

    string GetSemesterName(Semesters semester) => semester switch
    {
        Semesters.Первый => "1 семестр",
        Semesters.Второй => "2 семестр",
        Semesters.Третий => "3 семестр",
        Semesters.Четвертый => "4 семестр",
        Semesters.Пятый => "5 семестр",
        Semesters.Шестой => "6 семестр",
        Semesters.Седьмой => "7 семестр",
        Semesters.Восьмой => "8 семестр",
        _ => semester.ToString()
    };

    string FormatMarkDate(DateTime? markDate)
    {
        return markDate.HasValue
            ? markDate.Value.ToString("dd.MM.yyyy")
            : "—";
    }

    var startPage = Math.Max(1, Model.Groups.Page - 2);
    var endPage = Math.Min(Model.Groups.TotalPages, Model.Groups.Page + 2);
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Сведения об успеваемости</h2>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-app-outline"
               asp-controller="Home"
               asp-action="Index">
                Назад
            </a>

            <form asp-controller="DisciplineStudentRecords" asp-action="Sync" method="post" class="d-inline">
                <button type="submit" class="btn btn-app-primary">Синхронизировать данные</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success m-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger m-3">
            @TempData["Error"]
        </div>
    }

    <form method="get" class="p-3 pb-0">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input name="groupSearch"
                       type="text"
                       class="form-control"
                       placeholder="Поиск по группе"
                       value="@Model.GroupSearch" />
            </div>
            <div class="col-md-4">
                <input name="studentSearch"
                       type="text"
                       class="form-control"
                       placeholder="Поиск по студенту"
                       value="@Model.StudentSearch" />
            </div>
            <div class="col-md-auto d-flex gap-2">
                <input type="hidden" name="pageSize" value="@Model.Groups.PageSize" />
                <button type="submit" class="btn btn-app-outline">Применить</button>
                <a asp-controller="DisciplineStudentRecords"
                   asp-action="List"
                   class="btn btn-app-outline">
                    Сбросить
                </a>
            </div>
        </div>
    </form>

    <div class="px-3 pb-2 text-muted">
        Найдено групп: @Model.Groups.TotalCount
    </div>

    @if (groups.Count > 0)
    {
        @foreach (var group in groups)
        {
            var groupStudents = students
            .Where(x => x.StudentGroupId == group.Id)
            .OrderBy(x => x.LastName)
            .ThenBy(x => x.FirstName)
            .ThenBy(x => x.Patronymic)
            .ToList();

            var groupStudentIds = groupStudents.Select(x => x.Id).ToHashSet();

            var groupRecords = records
            .Where(x => groupStudentIds.Contains(x.StudentId))
            .ToList();

            var groupDebtRecords = groupRecords
            .Where(x => x.MarkType == MarkType.Неудовлетворительно)
            .ToList();

            var groupDebtStudentsCount = groupDebtRecords
            .Select(x => x.StudentId)
            .Distinct()
            .Count();

            var groupDisciplineIds = groupRecords
            .Select(x => x.DisciplineId)
            .Distinct()
            .ToHashSet();

            var groupDisciplines = disciplines
            .Where(x => groupDisciplineIds.Contains(x.Id))
            .OrderBy(x => x.DisciplineName)
            .ToList();

            var collapseId = $"groupMarks_{group.Id}";
            var buttonId = $"toggleBtn_{group.Id}";

            <div class="group-block">
                <div class="entity-row">
                    <div class="entity-accent"></div>

                    <div class="entity-content">
                        <div class="entity-main">
                            <h5 class="entity-title">@group.GroupName</h5>
                            <div class="entity-meta d-flex flex-column gap-1">
                                <div><strong>Направление:</strong> @group.EducationDirection</div>
                                <div><strong>Курс:</strong> @GetCourseName(group.Course)</div>
                                <div><strong>Количество студентов:</strong> @groupStudents.Count</div>
                                <div><strong>Количество дисциплин:</strong> @groupDisciplines.Count</div>

                                @if (groupDebtStudentsCount > 0)
                                {
                                    <div class="mt-2">
                                        <div class="alert alert-warning py-2 mb-0">
                                            <strong>Внимание:</strong>
                                            в группе есть студенты с академическими задолженностями —
                                            @groupDebtStudentsCount чел.
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(group.Curator))
                                {
                                    <div><strong>Куратор:</strong> @group.Curator</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="entity-actions">
                        <div class="actions-stack">
                            <a class="btn btn-sm btn-app-outline"
                               asp-controller="StudentGroups"
                               asp-action="Details"
                               asp-route-id="@group.Id">
                                Подробнее
                            </a>

                            <button id="@buttonId"
                                    class="btn btn-sm btn-app-outline"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                Показать таблицу
                            </button>
                        </div>
                    </div>
                </div>

                <div class="collapse" id="@collapseId">
                    <div class="group-marks-wrap">
                        @if (groupStudents.Count == 0)
                        {
                            <div class="text-muted">
                                В данной группе студенты отсутствуют.
                            </div>
                        }
                        else if (groupDisciplines.Count == 0)
                        {
                            <div class="text-muted">
                                Для студентов данной группы записи успеваемости отсутствуют.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive marks-table-wrap">
                                <table class="table table-bordered table-app marks-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="student-col">Студент</th>
                                            @foreach (var discipline in groupDisciplines)
                                            {
                                                <th class="discipline-col" title="@discipline.DisciplineName">
                                                    @discipline.DisciplineShortName
                                                </th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var student in groupStudents)
                                        {
                                            <tr class="student-record-row">
                                                <td class="student-col">
                                                    <div class="student-cell">
                                                        <div class="student-name">
                                                            <a class="text-decoration-none"
                                                               asp-controller="Students"
                                                               asp-action="Details"
                                                               asp-route-id="@student.Id"
                                                               asp-route-returnUrl="@returnUrl">
                                                                @student.LastName @student.FirstName @student.Patronymic
                                                            </a>
                                                        </div>
                                                        <div class="student-meta">
                                                            <span>Зачётная книжка: @student.NumberOfBook</span>
                                                            <span>Статус: @GetStudentStateName(student.StudentState)</span>
                                                            @if (student.IsSteward)
                                                            {
                                                                <span>Староста группы</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>

                                                @foreach (var discipline in groupDisciplines)
                                                {
                                                    var cellRecords = groupRecords
                                                    .Where(x => x.StudentId == student.Id && x.DisciplineId == discipline.Id)
                                                    .OrderBy(x => x.Semester)
                                                    .ThenBy(x => x.Variant)
                                                    .ToList();

                                                    <td>
                                                        @if (cellRecords.Count > 0)
                                                        {
                                                            <div class="mark-list">
                                                                @foreach (var record in cellRecords)
                                                                {
                                                                    <a class="@(record.MarkType == MarkType.Неудовлетворительно ? "mark-link debt-mark-link" : "mark-link")"
                                                                       asp-controller="DisciplineStudentRecords"
                                                                       asp-action="Details"
                                                                       asp-route-id="@record.Id"
                                                                       title="Семестр: @GetSemesterName(record.Semester) | Вариант: @record.Variant | Подгруппа: @record.SubGroup | Дата: @FormatMarkDate(record.MarkDate)">
                                                                        @GetMarkName(record.MarkType)
                                                                    </a>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="empty-mark">—</span>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="table-hint">
                                Нажмите на оценку, чтобы открыть подробную запись.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Groups.TotalPages > 1)
        {
            <div class="app-pagination-wrap">
                <div class="app-pagination-meta">
                    Страница @Model.Groups.Page из @Model.Groups.TotalPages
                    <span class="mx-2">•</span>
                    Всего групп: @Model.Groups.TotalCount
                </div>

                <nav class="app-pagination" aria-label="Пагинация">
                    <ul class="pagination mb-0">

                        @if (Model.Groups.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Groups.PageSize">
                                    В начало
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В начало</span>
                            </li>
                        }

                        @if (Model.Groups.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-page="@(Model.Groups.Page - 1)"
                                   asp-route-pageSize="@Model.Groups.PageSize">
                                    Назад
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Назад</span>
                            </li>
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Groups.PageSize">
                                    1
                                </a>
                            </li>

                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            if (p == Model.Groups.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@p</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="List"
                                       asp-route-groupSearch="@Model.GroupSearch"
                                       asp-route-studentSearch="@Model.StudentSearch"
                                       asp-route-page="@p"
                                       asp-route-pageSize="@Model.Groups.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                        }

                        @if (endPage < Model.Groups.TotalPages)
                        {
                            @if (endPage < Model.Groups.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-page="@Model.Groups.TotalPages"
                                   asp-route-pageSize="@Model.Groups.PageSize">
                                    @Model.Groups.TotalPages
                                </a>
                            </li>
                        }

                        @if (Model.Groups.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--nav"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-page="@(Model.Groups.Page + 1)"
                                   asp-route-pageSize="@Model.Groups.PageSize">
                                    Вперёд
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--nav">Вперёд</span>
                            </li>
                        }

                        @if (Model.Groups.Page < Model.Groups.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link page-link--wide"
                                   asp-action="List"
                                   asp-route-groupSearch="@Model.GroupSearch"
                                   asp-route-studentSearch="@Model.StudentSearch"
                                   asp-route-page="@Model.Groups.TotalPages"
                                   asp-route-pageSize="@Model.Groups.PageSize">
                                    В конец
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link--wide">В конец</span>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary m-3">
            По выбранным параметрам группы не найдены.
        </div>
    }
</div>

@section Styles {
    <style>
        .group-block {
            border-top: 1px solid var(--sky);
        }

            .group-block:first-of-type {
                border-top: none;
            }

            .group-block .entity-row {
                border-top: none;
            }

        .group-marks-wrap {
            margin-left: 8px;
            border-top: 1px solid var(--sky);
            background: #f8fbff;
            padding: 12px 14px 12px 22px;
        }

        .marks-table-wrap {
            background: #fff;
            border: 1px solid #e3eefb;
            border-radius: 10px;
            overflow: auto;
        }

        .marks-table {
            min-width: 900px;
            margin-bottom: 0;
        }

            .marks-table th,
            .marks-table td {
                vertical-align: top;
            }

        .student-col {
            min-width: 260px;
            max-width: 260px;
            position: sticky;
            left: 0;
            background: #fff;
            z-index: 1;
        }

        .marks-table thead .student-col {
            background: var(--sky);
            z-index: 3;
        }

        .discipline-col {
            min-width: 150px;
            max-width: 180px;
            word-break: break-word;
        }

        .student-cell {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .student-name {
            font-weight: 700;
            color: var(--galaxy);
            line-height: 1.2;
        }

        .student-meta {
            display: flex;
            flex-direction: column;
            gap: 2px;
            font-size: .85rem;
            color: #6c757d;
        }

        .mark-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .mark-link {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 8px;
            background: var(--sky);
            color: var(--galaxy);
            text-decoration: none;
            font-weight: 600;
            border: 1px solid var(--sky);
            text-align: center;
        }

            .mark-link:hover,
            .mark-link:focus {
                background: var(--galaxy);
                border-color: var(--galaxy);
                color: #fff;
            }

        .empty-mark {
            color: #9aa4b2;
            font-size: 1.1rem;
        }

        .table-hint {
            margin-top: 10px;
            font-size: .9rem;
            color: #6c757d;
        }

        .debt-mark-link {
            background: #fff3cd;
            border-color: #f1aeb5;
            color: #842029;
        }

            .debt-mark-link:hover,
            .debt-mark-link:focus {
                background: #842029;
                border-color: #842029;
                color: #fff;
            }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collapseElements = document.querySelectorAll('.collapse');

            collapseElements.forEach(function (collapseElement) {
                collapseElement.addEventListener('shown.bs.collapse', function () {
                    const button = document.querySelector('[data-bs-target="#' + collapseElement.id + '"]');
                    if (button && collapseElement.id.startsWith('groupMarks_')) {
                        button.textContent = 'Скрыть таблицу';
                    }
                });

                collapseElement.addEventListener('hidden.bs.collapse', function () {
                    const button = document.querySelector('[data-bs-target="#' + collapseElement.id + '"]');
                    if (button && collapseElement.id.startsWith('groupMarks_')) {
                        button.textContent = 'Показать таблицу';
                    }
                });
            });
        });
    </script>
}